{
  "name": "itr-osint-abogados",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "npm run pdf && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "pdf": "tsx scripts/generate-program.ts",
    "test": "playwright test",
    "audit": "node scripts/audit.mjs",
    "export:html": "npm run build && node scripts/export-preview.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@playwright/test": "^1.64.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
