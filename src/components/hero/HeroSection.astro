---
/**
 * Shared, single-source-of-truth Hero used by /, /ca/ and /en/.
 * Icons, structure and markup are identical across locales; only the copy rotates.
 */
import {type SupportedLocale} from '../../data/locales';
import HeroInvestigationScene from './HeroInvestigationScene.astro';

interface Props{locale?:SupportedLocale}
const {locale='es'}=Astro.props;
const pdfHref='/downloads/programa-investigacion-digital-abogados.pdf';
const enrollHref='https://perinfor.odoo.com/slides/acreditacion-tecnico-especialista-en-analisis-forense-en-la-web-10?utm_source=landing_osint_abogados&utm_medium=referral&utm_campaign=osint_juridico&utm_content=hero';

const copy={
 es:{eyebrow:'Curso de investigación digital para estudiantes · iTR+',h1:'Descubre cómo añadir a tu CV',h1b:'la investigación digital que buscan las empresas',intro:'Aprende a buscar, contrastar y documentar fuentes abiertas con una metodología práctica y rigurosa, y refuerza tu empleabilidad.',perks:['PDF por módulo','Foro de consultas','Acceso permanente'],cta:'Matricularme',download:'Descargar programa',probar:'Prueba gratuita',facts:[['100 %','online y con 4 clases prácticas con un profesor'],['7 módulos','de lo básico a lo avanzado'],['38 lecciones','con tests intermedios y evaluación final'],['30 horas','carga formativa estimada: incluye vídeos, ejercicios y la evaluación']]},
 ca:{eyebrow:"Curs d'investigació digital per a estudiants · iTR+",h1:'Descobreix com afegir al teu CV',h1b:"la investigació digital que busquen les empreses",intro:'Aprèn a cercar, contrastar i documentar fonts obertes amb una metodologia pràctica i rigorosa, i reforça la teva ocupabilitat.',perks:['PDF per mòdul','Fòrum de consultes','Accés permanent'],cta:'Matricular-me',download:'Descarrega el programa',probar:'Prova gratuïta',facts:[['100 %','en línia i amb 4 classes pràctiques amb un professor'],['7 mòduls','del bàsic a l\u2019avançat'],['38 lliçons','amb tests intermedis i avaluació final'],['30 hores','càrrega formativa estimada: inclou vídeos, exercicis i l’avaluació']]},
 en:{eyebrow:'Digital investigation course for students · iTR+',h1:'Discover how to add to your CV',h1b:'the digital investigation skills employers look for',intro:'Learn to find, verify and document open sources with a practical and rigorous methodology, and strengthen your employability.',perks:['PDF per module','Discussion forum','Permanent access'],cta:'Enroll now',download:'Download the programme',probar:'Free trial',facts:[['100 %','online with 4 practical classes with a teacher'],['7 modules','from basic to advanced'],['38 lessons','with intermediate quizzes and a final assessment'],['30 hours','estimated study load: includes videos, exercises and the final assessment']]}
}[locale];
---
<section class="hero" id="inicio"><canvas class="final-particles" aria-hidden="true"></canvas><div class="container hero-inner"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> {copy.eyebrow}</p><h1>{copy.h1} <span>{copy.h1b}</span></h1><p class="hero-value">{copy.intro}</p><ul class="hero-perks"><li><svg aria-hidden="true" viewBox="0 0 24 24" class="perk-icon"><path d="M6 2.5h9L19 6.5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Z"/><path d="M14.5 2.5V7H19M8 12h8M8 15.5h8M8 19h5"/></svg>{copy.perks[0]}</li><li><svg aria-hidden="true" viewBox="0 0 24 24" class="perk-icon"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.4 0-2.8-.3-4-.9L3 20l1-5.3a8.5 8.5 0 1 1 17-3.2Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/></svg>{copy.perks[1]}</li><li><svg aria-hidden="true" viewBox="0 0 24 24" class="perk-icon"><path d="M3 12c3-6 6-6 9 0s6 6 9 0M3 12c3 6 6 6 9 0s6-6 9 0"/></svg>{copy.perks[2]}</li></ul><div class="actions"><a class="button light enroll-cta" href={enrollHref}>{copy.cta} <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="button outline" href={pdfHref} download>{copy.download} ↓</a></div></div><div class="hero-media-column"><a class="hero-probar-link" href="#probar">{copy.probar}</a><HeroInvestigationScene/></div></div></div><div class="container hero-facts">{copy.facts.map(([num,label])=><div><strong>{num}</strong><span>{label}</span></div>)}</div></section>

<script>
  import {initFinalParticles} from '../../lib/final-particles';
  const hero = document.getElementById('inicio');
  if (hero) initFinalParticles(hero);
</script>
