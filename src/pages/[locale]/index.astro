---
import '../../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import {localizedData, type SupportedLocale} from '../../data/locales';
import {destination} from '../../lib/links';
import HeroSection from '../../components/hero/HeroSection.astro';
import ContextoEditorial from '../../components/ContextoEditorial.astro';
import TabNav from '../../components/TabNav.astro';
import Planner from '../../components/Planner';
import Audience from '../../components/Audience';
import CompetencyCards from '../../components/CompetencyCards.astro';
import CareerFAQ from '../../components/CareerFAQ.astro';
import EmploymentFAQ from '../../components/EmploymentFAQ.astro';
import SalidasLaborales from '../../components/SalidasLaborales.astro';
import Probar from '../../components/Probar.astro';
import CookieNotice from '../../components/CookieNotice.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import HeaderActions from '../../components/HeaderActions.astro';
import AudienceIntro from '../../components/AudienceIntro.astro';

export function getStaticPaths(){return [{params:{locale:'ca'}},{params:{locale:'en'}}];}
const locale=Astro.params.locale as SupportedLocale;
const t=localizedData(locale);
const legalHrefs=['aviso-legal','politica-de-privacidad','politica-de-cookies','accesibilidad'].map(slug=>`/${locale}/${slug}/`);
const tabOptions:readonly (readonly [string,string])[]=locale==='ca' ? [['Descripció i mètode didàctic','#metodo'],['Contingut','#programa'],['Adreçat a','#para-quien'],['Certificació','#certificacion'],['Sortides professionals','#salidas-laborales'],['FAQ','#preguntas'],['Prova gratuïta','#probar']] : [['Description and teaching method','#metodo'],['Content','#programa'],['Who it is for','#para-quien'],['Certification','#certificacion'],['Career paths','#salidas-laborales'],['FAQ','#preguntas'],['Free trial','#probar']];
const canonical=new URL(`/${locale}/`,Astro.site).href;
const production=import.meta.env.PUBLIC_DEPLOY_ENV==='production';
const schema={'@context':'https://schema.org','@type':'Course',name:t.title,description:t.description,url:canonical,inLanguage:t.lang};
const contact=(id:string)=>destination('contact',`${locale}_${id}`);
const captionSplit=t.caption.search(/ (I|AND) /);
const captionLines=[t.caption.slice(0,captionSplit),t.caption.slice(captionSplit+1)];
const course=(id:string)=>destination('course',`${locale}_${id}`);
const format=t.format;
const INCIBE_URL='https://www.incibe.es/incibe/sala-de-prensa/incibe-detecto-mas-de-122000-incidentes-de-ciberseguridad-en-2025';
const incibeLink=`<a href="${INCIBE_URL}" target="_blank" rel="noreferrer">INCIBE</a>`;
const contextCopy=locale==='ca'?{eyebrow:'01 / CONTEXT',title:'Quatre àrees',titleB:'d’investigació.',introStrongHtml:`El 2025, ${incibeLink} va registrar <strong>més de 122.000</strong> incidents de ciberseguretat a Espanya.`,introBody:'Especialitza’t en investigació digital i afegeix a la teva formació una competència que marca la diferència als processos de selecció.'}:{eyebrow:'01 / CONTEXT',title:'Four areas',titleB:'of investigation.',introStrongHtml:`In 2025, ${incibeLink} recorded <strong>more than 122,000</strong> cybersecurity incidents in Spain.`,introBody:'Specialise in digital investigation and add a skill to your training that makes the difference in selection processes.'};
const probarCopy=locale==='ca'?{eyebrow:'10 / PROVA EL MÈTODE',title:'Mapa de fonts.<br/>Un cas per practicar.',description:'Una demostració breu (2–4 minuts, sense registre): tria una ruta de cerca, llegeix el document, comprova’n la procedència i documenta què permeten afirmar les fonts. Dades simulades; no es fan cerques externes.'}:{eyebrow:'10 / TRY THE METHOD',title:'Source map.<br/>A case to practise.',description:'A short demonstration (2–4 minutes, no registration): choose a search route, read the document, verify its provenance and document what the sources support. Simulated data; no external searches are made.'};
---
<!doctype html><html lang={t.lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{t.title} | iTR+</title><meta name="description" content={t.description}/><meta name="robots" content={production?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="es" href={new URL('/',Astro.site).href}/><link rel="alternate" hreflang="ca" href={new URL('/ca/',Astro.site).href}/><link rel="alternate" hreflang="en" href={new URL('/en/',Astro.site).href}/><meta property="og:locale" content={locale==='ca'?'ca_ES':'en_GB'}/><link rel="icon" href="/favicon-itr.ico" sizes="16x16 32x32 48x48"/><link rel="icon" href="/images/favicon-itr-32.png" type="image/png" sizes="32x32"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body>
<a class="skip" href="#contenido">{t.skip}</a>
<header class="header"><div class="container header-inner"><BrandLogo href={`/${locale}/`} label="iTR+, home"/><span class="brand-caption">{captionLines[0]}<br/>{captionLines[1]}</span><nav class="locale-switcher" aria-label={locale==='ca'?'Idioma':'Language'}><a href="/" aria-label="ES">ES</a><a class={locale==='ca'?'is-active':undefined} href="/ca/" aria-label="CA">CA</a><a class={locale==='en'?'is-active':undefined} href="/en/" aria-label="EN">EN</a></nav><HeaderActions locale={locale}/></div></header>
<main id="contenido">
<HeroSection locale={locale}/>
<ContextoEditorial benefits={t.benefits} copy={contextCopy}/><TabNav options={tabOptions} ariaLabel={locale==='ca'?'Ordre del curs':'Course order'}/>
<section id="metodo" class="section container"><div class="section-head"><p class="eyebrow">02 / {locale==='ca'?'DESCRIPCIÓ I MÈTODE DIDÀCTIC':'DESCRIPTION AND TEACHING METHOD'}</p><h2>{t.method}</h2><p>{t.methodIntro}</p></div><div class="learning-grid">{t.learning.map(([title,description])=><article tabindex="0"><h3>{title}</h3><p>{description}</p></article>)}</div></section>
<div class="metodo-group"><section id="formacion" class="section dark method-section"><canvas class="section-particles" aria-hidden="true"></canvas><div class="container"><div class="section-head"><p class="eyebrow">03 / {t.rigor}</p><h2>{t.rigor}</h2><p>{locale==='ca'?'Estudi autònom, materials descarregables i un fòrum per als teus dubtes. Aprèn al teu ritme i completa les activitats, qüestionaris i l’avaluació final.':'Self-paced study, downloadable materials and a forum for your questions. Learn at your pace and complete activities, quizzes and the final assessment.'}</p></div><div class="formation-grid"><div class="facts-list"><article><span>{locale==='ca'?'Modalitat':'Format'}</span><h3>{format.mode}</h3><p>{format.materials}</p></article><article><span>{locale==='ca'?'Dedicació':'Study load'}</span><h3>{locale==='ca'?'30 hores de càrrega formativa estimada':'30 hours of estimated study load'}</h3><p>{t.durationNote}</p></article><article><span>{locale==='ca'?'Estructura':'Structure'}</span><h3>7 {locale==='ca'?'mòduls i 38 lliçons':'modules and 38 lessons'}</h3><p>{locale==='ca'?'Amb activitats, fòrum de consultes i avaluació final.':'With activities, a discussion forum and final assessment.'}</p></article><article><span>{locale==='ca'?'Requisits':'Requirements'}</span><h3>{locale==='ca'?'Sense coneixements previs':'No prior knowledge'}</h3><p>{format.support}</p></article></div><Planner client:visible={{rootMargin:'300px'}} locale={locale}/></div><div class="course-access-note"><h3>{locale==='ca'?'Sense terminis. Amb accés permanent.':'No deadlines. Permanent access.'}</h3><p>{format.pace}</p><p>{format.access}</p></div><div class="actions"><a class="button light" href={contact('acceso_permanente_contacto')}>{t.contact}</a><a class="text-link" href={course('condiciones')}>{locale==='ca'?'Informació completa i condicions del curs':'Full course information and conditions'} ↗</a></div></div></section></div>
<section id="programa" class="section container" data-group="contenido"><div class="section-head-wrap"><div class="section-head"><p class="eyebrow">05 / {locale==='ca'?'CONTINGUT DEL CURS':'COURSE CONTENT'}</p><h2>{t.program}</h2><p>{locale==='ca'?'7 mòduls per progressar del bàsic a l’avançat. 38 lliçons pràctiques amb recursos i exercicis guiats.':'Seven modules taking you from basic to advanced. 38 practical lessons with resources and guided exercises.'}</p></div><div class="program-tools"><button id="expand">{locale==='ca'?'Expandir-ho tot':'Expand all'}</button><button id="collapse">{locale==='ca'?'Contreure-ho tot':'Collapse all'}</button></div></div><div id="contenido-programa"><div class="curriculum">{t.curriculum.map((m,i)=><details data-module={i+1} id={`modulo-${i+1}`}><summary><span class="module-num">0{i+1}</span><span>{m.title}</span><span class="lesson-count">{m.lessons.length} {locale==='ca'?'lliçons':'lessons'}</span><span class="plus" aria-hidden="true">+</span></summary><ol>{m.lessons.map((lesson,j)=><li><span>{i+1}.{j+1}</span> {lesson}</li>)}</ol></details>)}</div><div class="evaluation"><strong>+ {locale==='ca'?'Avaluació final':'Final assessment'}</strong><p>{locale==='ca'?'Test final que valida els coneixements adquirits. És addicional a les 38 lliçons.':'A final test validating acquired knowledge. It is additional to the 38 lessons.'}</p><a href="/downloads/programa-investigacion-digital-abogados.pdf" download>{locale==='ca'?'Descarrega el programa complet':'Download the complete programme'} ↓</a></div></div><section class="topic-notes competencies-section"><p class="eyebrow">{locale==='ca'?'COMPETÈNCIES':'COMPETENCIES'}</p><h3>{locale==='ca'?'Coneix les competències i la seva aplicació':'Explore the competencies and their application'}</h3><CompetencyCards locale={locale}/></section></section>
<section id="para-quien" class="section surface"><div class="container"><div class="section-head"><p class="eyebrow">06 / {locale==='ca'?'ADREÇAT A':'WHO IT IS FOR'}</p><h2>{t.audience}</h2><p>{locale==='ca'?'Adreçat a estudiants que volen adquirir habilitats addicionals en investigació digital per millorar la seva ocupabilitat.':'For students who want to acquire additional digital investigation skills to improve their employability.'}</p></div><Audience client:visible specialties={t.specialties} copy={{eyebrow:locale==='ca'?'UN EXEMPLE EN LA TEVA ESPECIALITAT':'AN EXAMPLE IN YOUR SPECIALISM',note:locale==='ca'?'Exemple didàctic, no assessorament sobre un cas real.':'Teaching example, not advice about a real case.'}}/><AudienceIntro locale={locale}/></div></section>
<section id="certificacion" class="section surface"><div class="container certification certification-modern"><div><p class="eyebrow">07 / {locale==='ca'?'CERTIFICACIÓ':'CERTIFICATION'}</p><h2>{t.cert}</h2><p>{locale==='ca'?'Impulsa la teva carrera amb una formació d’alt impacte avalada per iTR+ i el Col·legi Oficial d’Enginyeria en Informàtica de Catalunya (COEINF).':'Advance your career with high-impact training supported by iTR+ and the Col·legi Oficial d’Enginyeria en Informàtica de Catalunya (COEINF).'}</p><a class="institution-link" href="https://enginyeriainformatica.cat/inici/" target="_blank" rel="noreferrer">{locale==='ca'?'Visitar COEINF':'Visit COEINF'} ↗</a></div><div class="certification-media"><img src="/images/coeinf-institutional-photo.png" width="1060" height="493" alt={locale==='ca'?'Professionals reunits en un auditori':'Professionals gathered in an auditorium'} loading="lazy"/><div class="coeinf-mark"><img src="/images/coeinf-logo.png" width="2048" height="1024" alt="COEINF" loading="lazy"/></div></div></div></section><SalidasLaborales locale={locale}/>
<section id="preguntas" class="section container faq"><div><p class="eyebrow">09 / {locale==='ca'?'ABANS DE COMENÇAR':'BEFORE YOU START'}</p><h2>{t.faqTitle}</h2><p>{locale==='ca'?'La informació pública exigeix un ús responsable, respecte a la privacitat i documentació rigorosa.':'Public information requires responsible use, respect for privacy and rigorous documentation.'}</p></div><div>{t.faq.map(([q,a])=><details class="faq-item"><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}<CareerFAQ locale={locale}/><EmploymentFAQ locale={locale}/><a class="text-link" href={course('faq')}>{locale==='ca'?'Accedir al curs a iTR+':'Access the iTR+ course'} ↗</a></div></section><Probar locale={locale} copy={probarCopy}/>
<section id="informacion" class="section final dark"><canvas class="final-particles" aria-hidden="true"></canvas><div class="container"><p class="eyebrow">{locale==='ca'?'EL TEU SEGÜENT PAS':'YOUR NEXT STEP'}</p><h2>{t.next}</h2><p>{locale==='ca'?'Fes un pas més en la teva formació: descobreix com localitzar, contrastar i analitzar informació pública i reforça el teu perfil de cara al mercat laboral.':'Take the next step in your training: learn how to find, verify and analyse public information and strengthen your profile for the job market.'}</p><div class="actions"><a class="button light" href={contact('siguiente_paso_contacto')}>{t.contact}</a><a class="text-link" href={course('cierre_secundario')}>{locale==='ca'?'Vull més informació':'I want more information'} ↗</a></div></div></section>
</main><footer class="container footer"><BrandLogo href={`/${locale}/`} label="iTR+, home"/><p>{t.footer}</p><nav class="footer-legal" aria-label={locale==='ca'?'Informació legal':'Legal information'}>{legalHrefs.map((href,i)=><a href={href}>{t.legal[i]}</a>)}<button type="button" data-consent-configure>{t.configure}</button></nav><a href={contact('footer_contactar')}>{t.contactFooter} ↗</a><p class="small">{locale==='ca'?'Sense analítica ni galetes de màrqueting actives sense el teu consentiment.':'No analytics or marketing cookies are active without your consent.'}<br/>© {new Date().getFullYear()} iTR+</p></footer><aside class="mobile-cta" hidden><a class="button" href={course('movil')}>{locale==='ca'?'Sol·licita informació':'Request information'} ↗</a></aside><CookieNotice locale={locale}/>
<script>
import {initSectionParticles} from '../../lib/section-particles';
import {initFinalParticles} from '../../lib/final-particles';
import {initCompetencyCards} from '../../lib/competency-cards';
const method=document.getElementById('formacion'); if(method)initSectionParticles(method); initCompetencyCards();
const modules=document.querySelectorAll<HTMLDetailsElement>('[data-module]'); document.getElementById('expand')?.addEventListener('click',()=>modules.forEach(m=>m.open=true)); document.getElementById('collapse')?.addEventListener('click',()=>modules.forEach(m=>m.open=false));
const header=document.querySelector<HTMLElement>('.header'),tabs=document.querySelector<HTMLElement>('.tabnav'); const measure=()=>{document.documentElement.style.setProperty('--header-h',`${header?.offsetHeight||92}px`);document.documentElement.style.setProperty('--tabnav-h',`${tabs?.offsetHeight||0}px`)}; measure(); new ResizeObserver(measure).observe(document.body);
const finalSection=document.getElementById('informacion'); if(finalSection)initFinalParticles(finalSection);
</script></body></html>
