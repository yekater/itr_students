---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import {curriculum} from '../data/curriculum';
import {courseFormat} from '../data/course-format';
import CareerFAQ from '../components/CareerFAQ.astro';
import EmploymentFAQ from '../components/EmploymentFAQ.astro';
import {learning,faq,durationDetail,durationNote,CORPORATE_URL} from '../data/site';
import {destination} from '../lib/links';
import TabNav from '../components/TabNav.astro';
import AudienceIntro from '../components/AudienceIntro.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import SalidasLaborales from '../components/SalidasLaborales.astro';
import Probar from '../components/Probar.astro';
import CompetencyCards from '../components/CompetencyCards.astro';
import Audience from '../components/Audience';
import Planner from '../components/Planner';
import CookieNotice from '../components/CookieNotice.astro';
import ContextoEditorial from '../components/ContextoEditorial.astro';
import BrandLogo from '../components/BrandLogo.astro';
import HeaderActions from '../components/HeaderActions.astro';
const production=import.meta.env.PUBLIC_DEPLOY_ENV==='production';
const canonical=new URL('/',Astro.site).href;
const contact=(id:string)=>destination('contact',id),course=(id:string)=>destination('course',id);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':CORPORATE_URL+'#organization',name:'iTR+',url:CORPORATE_URL},{'@type':'WebSite','@id':canonical+'#website',url:canonical,name:'iTR+ · Investigación digital para estudiantes',inLanguage:'es-ES'},{'@type':'Course',name:'Curso iTR+ de investigación digital para estudiantes',description:'Formación especializada en investigación digital mediante fuentes abiertas',url:canonical,provider:{'@id':CORPORATE_URL+'#organization'}}]};
 ---
<!doctype html><html lang="es-ES"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Curso iTR+ de investigación digital para estudiantes | iTR+</title><meta name="description" content="Aprende a buscar, contrastar y documentar información pública y mejora tu empleabilidad. Curso online de investigación digital de iTR+. Consulta programa y condiciones."/><meta name="robots" content={production?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><meta property="og:title" content="Añade la investigación digital a tu CV · iTR+"/><meta property="og:description" content="Curso iTR+ para estudiantes. Aprende a localizar, contrastar y documentar información pública y refuerza tu empleabilidad."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_ES"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/equipo-abogados-investigacion-digital-itr.jpg',Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon-itr.ico" sizes="16x16 32x32 48x48"/><link rel="icon" href="/images/favicon-itr-32.png" type="image/png" sizes="32x32"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a>
 <header class="header"><div class="container header-inner"><BrandLogo href="#inicio"/><span class="brand-caption">INVESTIGACIÓN<br/>Y FORMACIÓN DIGITAL</span><nav class="locale-switcher" aria-label="Idioma"><a class="is-active" href="/" aria-label="ES — Español">ES</a><a href="/ca/" aria-label="CA — Català">CA</a><a href="/en/" aria-label="EN — English">EN</a></nav><HeaderActions/></div></header>
<main id="contenido">
  <HeroSection/>
 <ContextoEditorial/><TabNav/><!-- Grupo de método: De la primera búsqueda… / Rigor en el método… --><section id="metodo" class="section container"><div class="section-head"><p class="eyebrow">02 / DESCRIPCIÓN Y MÉTODO DIDÁCTICO</p><h2>De la primera búsqueda<br/>al informe documentado.</h2><p>Descubre el potencial de la investigación digital y aprende técnicas de investigación en fuentes abiertas. Búsqueda avanzada, investigación de sociedades, herramientas digitales e informes con enfoque práctico y profesional.</p></div><div class="learning-grid">{learning.map(([title,description])=><article><h3>{title}</h3><p>{description}</p></article>)}</div></section>

  <div class="metodo-group"><section id="formacion" class="section dark method-section"><canvas class="section-particles" aria-hidden="true"></canvas><div class="container"><div class="section-head"><p class="eyebrow">03 / RIGOR EN EL MÉTODO, FLEXIBILIDAD EN TU AGENDA</p><h2>Rigor en el método.<br/>Flexibilidad en tu agenda.</h2><p>Estudio autónomo, materiales descargables y un foro para tus dudas. Aprende a tu ritmo, trabaja las actividades y realiza los cuestionarios y la evaluación final.</p></div><div class="formation-grid"><div class="facts-list"><article><span>Modalidad</span><h3>100 % online con 4 clases prácticas con un profesor</h3><p>{courseFormat.materials}</p></article><article><span>Dedicación</span><h3>30 horas de carga formativa estimada</h3><p>{durationNote}</p></article><article><span>Estructura</span><h3>7 módulos y 38 lecciones</h3><p>Con actividades, foro de consulta y evaluación final.</p></article><article><span>Requisitos</span><h3>Sin conocimientos previos</h3><p>Enfoque práctico y legal. Puedes plantear tus preguntas al creador y al mentor del curso en el foro.</p></article></div><Planner client:visible={{rootMargin:"300px"}}/></div><div class="course-access-note"><h3>Sin plazos. Con acceso permanente.</h3><p>{courseFormat.pace}</p><p>{courseFormat.access}</p></div><div class="actions"><a class="button light" href={contact('acceso_permanente_contacto')}>Contacto</a><a class="text-link" href={course('condiciones')}>Información completa y condiciones del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></section></div>

<section id="programa" class="section container" data-group="contenido"><div class="section-head-wrap"><div class="section-head"><p class="eyebrow">05 / CONTENIDO DEL CURSO</p><h2>Tu programa de investigación.</h2><p>7 módulos estructurados para progresar desde lo básico a lo avanzado. 38 lecciones prácticas con recursos y ejercicios guiados.</p></div><div class="program-tools"><button id="expand">Expandir todo</button><button id="collapse">Contraer todo</button></div></div><div id="contenido-programa"><div class="curriculum">{curriculum.map((m,i)=><details data-module={i+1} id={`modulo-${i+1}`}><summary><span class="module-num">0{i+1}</span><span>{m.title}</span><span class="lesson-count">{m.lessons.length} lecciones</span><span class="plus" aria-hidden="true">+</span></summary><ol>{m.lessons.map((lesson,j)=><li><span>{i+1}.{j+1}</span> {lesson}</li>)}</ol></details>)}</div><div class="evaluation"><strong>+ Evaluación final</strong><p>Test final que valida los conocimientos adquiridos. Es adicional a las 38 lecciones, no un octavo módulo formativo.</p><a href="/downloads/programa-investigacion-digital-abogados.pdf" download>Descargar programa completo ↓</a></div></div><section class="topic-notes competencies-section" aria-labelledby="competencies-title"><p class="eyebrow">COMPETENCIAS</p><h3 id="competencies-title">Conoce las competencias y su aplicación</h3><CompetencyCards/></section></section>
<section id="para-quien" class="section surface"><div class="container"><div class="section-head"><p class="eyebrow">06 / DIRIGIDO A</p><h2>¿A quién va dirigido?</h2><p>Dirigido a estudiantes que desean adquirir habilidades adicionales en investigación digital para mejorar su empleabilidad.</p></div><Audience client:visible={{rootMargin:"300px"}}/><AudienceIntro/></div></section>
<section id="certificacion" class="section surface"><div class="container certification certification-modern"><div><p class="eyebrow">07 / CERTIFICACIÓN</p><h2>Doble Certificación Oficial: iTR+ y COEINF</h2><p>Impulsa tu carrera IT con una titulación de alto impacto avalada por iTR+ y el Col·legi Oficial d’Enginyeria en Informàtica de Catalunya (COEINF). Demuestra ante los reclutadores tu rigor técnico y excelencia profesional con un sello institucional que te posiciona por encima de la competencia. ¡Destaca en el sector tecnológico!</p><a class="institution-link" href="https://enginyeriainformatica.cat/inici/" target="_blank" rel="noreferrer">Visitar COEINF <span aria-hidden="true">↗</span></a></div><div class="certification-media"><img src="/images/coeinf-institutional-photo.png" width="1060" height="493" alt="Grupo de profesionales reunidos en un auditorio institucional" loading="lazy"/><div class="coeinf-mark"><img src="/images/coeinf-logo.png" width="2048" height="1024" alt="COEINF" loading="lazy"/></div></div></div></section><SalidasLaborales/>
<section id="preguntas" class="section container faq"><div><p class="eyebrow">09 / ANTES DE EMPEZAR</p><h2>Preguntas<br/>frecuentes.</h2><p>La información pública exige un uso responsable: finalidad legítima, respeto a la privacidad, límites de acceso y documentación rigurosa.</p></div><div>{faq.map(([q,a])=><details class="faq-item"><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}<CareerFAQ/><EmploymentFAQ/><a class="text-link" href={course('faq')}>Acceder al curso en iTR+ <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></section><Probar/>
  <section id="informacion" class="section final dark"><canvas class="final-particles" aria-hidden="true"></canvas><div class="container"><p class="eyebrow">TU SIGUIENTE PASO</p><h2>Añade una competencia<br/>que marca la diferencia.</h2><p>Da un paso más en tu formación: descubre cómo localizar, contrastar y analizar información pública y refuerza tu perfil de cara al mercado laboral.</p><p>Consulta el programa, la dedicación y las condiciones de la formación.</p><div class="actions"><a class="button light" href={contact('siguiente_paso_contacto')}>Contacto</a><a class="text-link" href={course('cierre_secundario')}>Quiero más información <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></section>
 </main><footer class="container footer"><BrandLogo href="#inicio"/><p>Formación especializada en investigación<br/>digital mediante fuentes abiertas.</p><nav class="footer-legal" aria-label="Información legal"><a href="/aviso-legal/">Aviso legal</a><a href="/politica-de-privacidad/">Política de privacidad</a><a href="/politica-de-cookies/">Política de cookies</a><a href="/accesibilidad/">Accesibilidad</a><button type="button" data-consent-configure>Configurar cookies</button></nav><a href={contact('pie')}>Contactar con iTR+ <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><p class="small">Sin analítica ni cookies de marketing activas sin tu consentimiento.<br/>© {new Date().getFullYear()} iTR+</p></footer><aside class="mobile-cta" hidden><a class="button" href={course('movil')}>Solicitar información <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></aside><CookieNotice/>

<script>
 import {track} from '../lib/analytics';
   import {initSectionParticles} from '../lib/section-particles';
   import {initFinalParticles} from '../lib/final-particles';
  import {initCompetencyCards} from '../lib/competency-cards';

  const methodSection=document.getElementById('formacion');
  if(methodSection)initSectionParticles(methodSection);
  initCompetencyCards();
  const methodCards=document.querySelectorAll<HTMLElement>('.learning-grid article');
  document.documentElement.classList.add('js-method-ready');
  const methodObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-revealed');methodObserver.unobserve(entry.target)}}),{threshold:.15});
  methodCards.forEach((card,index)=>{card.tabIndex=0;card.style.setProperty('--method-delay',`${index*.12}s`);methodObserver.observe(card)});

 // Alturas reales de cabecera y barra de pestañas para los offsets de scroll.
 const header=document.querySelector<HTMLElement>('.header');
 const tabnav=document.querySelector<HTMLElement>('.tabnav');
 function measure(){const r=document.documentElement.style;r.setProperty('--header-h',(header?.offsetHeight||92)+'px');r.setProperty('--tabnav-h',tabnav?tabnav.offsetHeight+'px':'0px');}
 if(header||tabnav){measure();new ResizeObserver(measure).observe(document.body);}



 // Programa: expandir/contraer sin tocar otros acordeones.
 const modules=document.querySelectorAll<HTMLDetailsElement>('[data-module]');
 document.getElementById('expand')?.addEventListener('click',()=>modules.forEach(d=>d.open=true));
 document.getElementById('collapse')?.addEventListener('click',()=>modules.forEach(d=>d.open=false));
 modules.forEach(d=>d.addEventListener('toggle',()=>{if(d.open)track('program_open',{module_id:d.dataset.module})}));

 // Un módulo enlazado desde una tarjeta puede abrirse al llegar a su fragmento.
 function openTargetModule(){const id=decodeURIComponent(location.hash.slice(1));const module=document.querySelector<HTMLDetailsElement>(`details[id="${id}"]`);if(module&&!module.open){module.open=true;track('program_open',{module_id:module.dataset.module})}}
 openTargetModule();window.addEventListener('hashchange',openTargetModule);

 document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(d=>d.addEventListener('toggle',()=>{if(d.open)track('faq_open',{section_id:'preguntas'})}));
 document.querySelectorAll<HTMLAnchorElement>('a[href*="perinfor.odoo.com"]').forEach(a=>a.addEventListener('click',()=>track(a.pathname.includes('/slides/')?'course_platform_click':'cta_info_click',{cta_id:new URL(a.href).searchParams.get('utm_content')||'enlace',destination_type:a.pathname.includes('/slides/')?'course':'contact'})));

 // CTA fijo móvil: oculto mientras el hero es visible.
 const bar=document.querySelector<HTMLElement>('.mobile-cta');
 const hero=document.getElementById('inicio');
 if(bar&&hero)new IntersectionObserver(e=>{bar.hidden=e[0].isIntersecting},{threshold:.2}).observe(hero);

 // Activo con scroll (no solo con clic): cabezas de los destinos de la barra de pestañas.
 const navLinks=document.querySelectorAll<HTMLAnchorElement>('.tabnav a[href^="#"]');
 const targets:Element[]=[];
 navLinks.forEach(a=>{const id=decodeURIComponent(a.hash.slice(1));const target=id&&document.getElementById(id);if(target&&!targets.includes(target))targets.push(target)});
 function setActive(id:string){navLinks.forEach(a=>{if(a.hash==='#'+id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}
 let best=targets[0] as HTMLElement|undefined;
 const onScroll=()=>{const line=window.innerHeight*.32;let current:HTMLElement|undefined;for(const target of targets as HTMLElement[]){if(target.getBoundingClientRect().top<=line)current=target}if(current!==best){best=current;if(current)setActive(current.id)}};
 if(targets.length){onScroll();window.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',onScroll);window.addEventListener('hashchange',()=>{requestAnimationFrame(()=>{onScroll();if(best)setActive(best.id)})})}

  // Partículas decorativas del cierre: reaccionan al cursor dentro de la sección.
  // Sin animación si se prefiere movimiento reducido; se detienen fuera de pantalla.
  const finalSection=document.getElementById('informacion');
  if(finalSection)initFinalParticles(finalSection);

</script></body></html>
